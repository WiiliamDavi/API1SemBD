
# TURNO DA MANHÃ


turno_manha_CD = int(input("Digite o número de Clínicos Gerais do turno da manhã: "))
turno_manha_Ped = int(input("Digite o número de Pediatras do turno da manhã: "))
turno_manha_Cir = int(input("Digite o número de Cirurgiões do turno da manhã: "))

print("\nConfirme os dados do turno da manhã:")
print("Clínicos Gerais:", turno_manha_CD)
print("Pediatras:", turno_manha_Ped)
print("Cirurgiões:", turno_manha_Cir)

button = input("Digite 's' para confirmar ou 'n' para corrigir: ")

while button.lower() == 'n':
    turno_manha_CD = int(input("Digite o número de Clínicos Gerais do turno da manhã: "))
    turno_manha_Ped = int(input("Digite o número de Pediatras do turno da manhã: "))
    turno_manha_Cir = int(input("Digite o número de Cirurgiões do turno da manhã: "))

    print("\nConfirme os dados do turno da manhã:")
    print("Clínicos Gerais:", turno_manha_CD)
    print("Pediatras:", turno_manha_Ped)
    print("Cirurgiões:", turno_manha_Cir)

    button = input("Digite 's' para confirmar ou 'n' para corrigir: ")

print("Dados do turno da manhã confirmados.")


